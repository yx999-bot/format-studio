{
  "name": "@local/format-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Format Studio: paste a full text, pick a Chinese document format (paper, government document, report, news, proposal, letter, resume) and generate a properly typeset Word file.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
